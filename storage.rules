rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// İnşaat Takip — Storage güvenlik kuralları (madde 17)
//
// YETKİ MODELİ FIRESTORE'UN AYNASI: kim neyi okur/yazar sorusunun cevabı tek
// yerde (projects/{pid}.ownerUid / memberUids) durur; Storage kuralları oraya
// ÇAPRAZ SERVİS `firestore.get()` ile bakar. Yetki iki yerde tekrarlansaydı
// biri güncellenip diğeri unutulurdu.
//
// YOL ŞEMASI — Firestore koleksiyon adlarıyla bire bir:
//   projects/{pid}/sitePhotos/{photoId}.jpg        → ortak OKUR
//   projects/{pid}/apartmentPhotos/{photoId}.jpg   → ortak OKUR
//   projects/{pid}/receipts/{logId}.jpg            → ortak OKUR (malzeme/gider fişi)
//   projects/{pid}/paymentReceipts/{paymentId}.jpg → YALNIZCA YÖNETİCİ
//
// KISITLAR:
//   · Yalnızca image/jpeg — uygulama zaten her görseli 1200px JPEG'e küçültüyor
//     (madde 13); başka tür bir yükleme uygulamadan gelmiyor demektir.
//   · 4 MB üst sınır: 1200px JPEG tipik ~300-500 KB; sınır, ele geçirilmiş bir
//     oturumun depoyu çöplüğe çevirmesine karşı tavan.
//
// KİŞİSEL VERİ — TAHSİLAT DEKONTU AYRI KOVADA:
// Alıcının adı Firestore'da bilinçli olarak `buyers/{apartmentId}` belgesine
// ayrıldı ve yalnızca yöneticiye açıldı (madde 18); gerekçe orada yazılı —
// güvenlik kuralı ALAN gizleyemez, belge gizler. Tahsilat dekontunun üstünde
// gönderenin adı soyadı (çoğu kez IBAN'ı da) yazıyor: aynı kişisel veri.
// Malzeme fişiyle aynı kovada dursaydı, ortak `payments` belgesinden okuduğu
// `paymentId` ile dekonta erişir ve Firestore'da kapatılan sızıntı Storage
// üzerinden aynen geri açılırdı. Bu yüzden ayrı yol, ayrı okuma kuralı.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function projectData(pid) {
      return firestore.get(/databases/(default)/documents/projects/$(pid)).data;
    }

    function isOwner(pid) {
      return request.auth != null && projectData(pid).ownerUid == request.auth.uid;
    }

    function isMember(pid) {
      return request.auth != null && request.auth.uid in projectData(pid).memberUids;
    }

    function isSmallJpeg() {
      return request.resource.contentType == 'image/jpeg'
          && request.resource.size < 4 * 1024 * 1024;
    }

    /// Ortağın okuyabildiği kovalar. Ortak aynı harcamayı listede zaten
    /// görüyor; fişi de görmesi şeffaflığın parçası.
    function memberReadable(collection) {
      return collection in ['sitePhotos', 'apartmentPhotos', 'receipts'];
    }

    /// Yalnızca yöneticinin okuyabildiği kovalar (yukarıdaki KİŞİSEL VERİ notu).
    function ownerReadable(collection) {
      return collection == 'paymentReceipts';
    }

    /// Bilinen görsel kovaları. Liste AÇIK: yeni bir kova eklendiğinde buraya
    /// da yazılmalı — sessizce dünyaya açılan yol olmasın.
    function knownCollection(collection) {
      return memberReadable(collection) || ownerReadable(collection);
    }

    match /projects/{pid}/{collection}/{file} {
      allow read: if (memberReadable(collection) && isMember(pid))
                  || (ownerReadable(collection) && isOwner(pid));
      allow create, update: if knownCollection(collection) && isOwner(pid) && isSmallJpeg();
      allow delete: if knownCollection(collection) && isOwner(pid);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // BELGELER (madde 23) — plan, ruhsat, sözleşme dosyaları
    //
    // AYRI BLOK, çünkü yukarıdaki görsel kalıbı belgeye İKİ yönden uymuyor:
    //
    //  1. TÜR VE BOYUT. `isSmallJpeg()` yalnızca `image/jpeg` ve 4 MB kabul
    //     ediyor; belge PDF/DWG olabiliyor ve uygulama 50 MB duyuruyor.
    //
    //  2. GÖRÜNÜRLÜK BELGE BAZLI. Görsellerde yetki KOVA düzeyinde: bir kovayı
    //     ortak ya tamamen okur ya hiç okumaz. Belgede öyle değil —
    //     `ProjectDocument.partnerVisible` her belge için ayrı karar veriyor ve
    //     `firestore.rules` bunu zaten uyguluyor ("gizli belge ortağın yerel
    //     önbelleğine hiç inmez"). Kova düzeyinde açılsaydı Firestore'da
    //     kapatılan sızıntı Storage'dan aynen geri açılırdı — tahsilat
    //     dekontunda verilen kararın aynısı, bu sefer belge bazında.
    //
    // NESNE ADI = FIRESTORE BELGE KİMLİĞİ, uzantı YOK. Kural, kardeş Firestore
    // belgesini ancak kimliği yoldan çözebilirse okuyabiliyor. Gerçek dosya adı
    // ve uzantı Firestore belgesinde duruyor; indirilen bayt yerel geçici
    // dosyaya o uzantıyla yazılıyor (önizleme uzantıya bakıyor).
    match /projects/{pid}/documents/{docId} {

      /// Kardeş Firestore belgesi. Yoksa `get()` null döner ve `.data`
      /// erişimi kuralı düşürür — yani ÜST VERİSİ OLMAYAN bir nesne hiç
      /// okunamaz. Bu kasıtlı: yetim bayt yüklenmesin.
      function documentData() {
        return firestore.get(
          /databases/(default)/documents/projects/$(pid)/documents/$(docId)
        ).data;
      }

      /// 50 MB tavan uygulamanın duyurduğu sınırla AYNI (UploadSheet).
      /// İkisi ayrışırsa kullanıcı "yükleniyor" görüp sunucudan red alır.
      function isAllowedDocument() {
        return request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType != null;
      }

      allow read: if isOwner(pid)
                  || (isMember(pid) && documentData().partnerVisible == true);
      allow create, update: if isOwner(pid) && isAllowedDocument();
      allow delete: if isOwner(pid);
    }

    // Varsayılan: RED. Firestore kurallarındaki son satırla aynı gerekçe.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

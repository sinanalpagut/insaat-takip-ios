rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// İnşaat Takip — Firestore güvenlik kuralları
//
// TEMEL İLKE: yetki BURADA belirlenir, istemcide değil. Uygulamadaki rol
// bugün kullanıcı başına global (bkz. AppState — bilinen sınır) ama bu kurallar
// yetkiyi PROJE BAŞINA çözüyor: bir kişi kendi projesinde yönetici, davet
// edildiği projede yalnızca okuyucudur. İstemcinin global rolü artık sadece
// arayüz ipucu; sunucu doğru modeli uyguluyor.
//
// KURALLAR SÜZGEÇ DEĞİLDİR. Bir kural belgeyi doğrular, sorguya kapsam VERMEZ.
// `partnerVisible == false` belgeler için bu şu demek: ortağın sorgusu
// `whereField("partnerVisible", isEqualTo: true)` biçiminde kurulmak ZORUNDA;
// aksi halde kural tek tek belgeleri gizlemez, sorgunun TAMAMINI reddeder ve
// ekran boş kalır. (ANALIZ.md madde 18)
//
// ─── Şema sözleşmesi (FirestoreProjectRepository bunlara uymak zorunda) ───
//
//   users/{uid}                              → profil (ad, telefon)
//   projects/{pid}                           → ownerUid, memberUids[], invite
//   projects/{pid}/materials/{id}
//   projects/{pid}/materialLogs/{id}
//   projects/{pid}/apartments/{id}
//   projects/{pid}/partners/{id}
//   projects/{pid}/documents/{id}            → partnerVisible: Bool
//   projects/{pid}/activities/{id}           → EKLE-ONLY
//   projects/{pid}/sitePhotos/{id}
//   projects/{pid}/expenses/{id}
//   projects/{pid}/payments/{id}
//   projects/{pid}/partnerLedger/{id}        → ortak cari (sermaye/çekim/dağıtım)
//   projects/{pid}/apartmentPhotos/{id}
//   projects/{pid}/auditEntries/{id}         → EKLE-ONLY
//
//   · Belge kimliği = modeldeki `id.uuidString`.
//   · Alt koleksiyondaki her belge `projectId` taşır ve bu, üst yolun `pid`'ine
//     EŞİT olmalı. Aksi halde bir belge başka bir projeye aitmiş gibi görünüp
//     istemcinin süzgeçlerini şaşırtabilirdi.
//
// ─── İKİ AŞAMALI PROJE KURULUMU (zorunlu) ───
//
// Alt koleksiyon yazmaları üst proje belgesini `get()` ile doğruluyor. Firestore
// kural değerlendirmesi, AYNI partideki henüz işlenmemiş yazmaları GÖRMEZ. Yani
// `projects/{pid}` ile `projects/{pid}/apartments/{id}` tek `WriteBatch` içinde
// gönderilirse alt belgeler REDDEDİLİR (üst belge o an mevcut değil).
//
// Bugünkü `ProjectViewModel.addProject` proje + ~20 daire + 9 malzemeyi tek
// partide veriyor. `FirestoreProjectRepository` bunu İKİ aşamaya bölmek zorunda:
//   1) `projects/{pid}` tek başına işlenir,
//   2) daireler/malzemeler tek parti olarak işlenir.
// Bu kısıt `tests/rules.test.mjs` içinde bir testle sabitlendi ("aynı partide
// proje + daire reddedilir") — yorumla değil, çalışan bir denetimle.
//
// Kurulum DIŞINDAKİ her eylemde (fiş, satış iptali, düzenleme…) üst belge zaten
// var, dolayısıyla `apply([DocumentChange])`ın atomiklik sözü BOZULMUYOR.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── Yardımcılar ───────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    /// Üst proje belgesi. Belge yoksa `get()` null döner, `.data` hata verir ve
    /// kural REDDE düşer — güvenli yön.
    function projectData(pid) {
      return get(/databases/$(database)/documents/projects/$(pid)).data;
    }

    /// Projeyi kuran kişi. Yazma yetkisinin TEK kaynağı.
    function isOwner(pid) {
      return signedIn() && projectData(pid).ownerUid == uid();
    }

    /// Projeyi görebilenler (sahip dahil). Salt okuma yetkisi.
    function isMember(pid) {
      return signedIn() && uid() in projectData(pid).memberUids;
    }

    /// Alt koleksiyon belgesi doğru projeye mi yazılıyor?
    function pathBound(pid) {
      return request.resource.data.projectId == pid;
    }

    /// SUNUCU DAMGASI ZORUNLU — madde 77.
    ///
    /// Her yazma `updatedAt` (sunucu saati) ve `updatedBy` (yazan hesabın
    /// uid'i) taşımak ZORUNDA ve ikisi de burada doğrulanıyor. Önceden bu
    /// alanlar yazılıyordu ama KURAL HİÇ BAKMIYORDU: dosyada tek bir
    /// `request.time` ya da alan doğrulaması yoktu.
    ///
    /// `updatedAt == request.time` şartı yalnızca `FieldValue.serverTimestamp()`
    /// ile yazıldığında sağlanır. İstemci kendi saatinden bir `Timestamp`
    /// koyarsa değer sunucununkiyle tutmaz ve yazma REDDEDİLİR. Yani cihaz
    /// saati yanlışsa ya da kasten geri alınmışsa kayıt yazılamaz — yanlış
    /// tarihle yazılmaz.
    ///
    /// NEDEN ÖNEMLİ: denetim izinin tüm değeri tarihlerinde. "Kim ne zaman
    /// değiştirdi" sorusunun cevabı cihazın saatinden geliyorsa iz bir kanıt
    /// değil bir İDDİADIR — ve madde 76 ile o iz artık ortağın gördüğü bir
    /// ekranda.
    ///
    /// BİLİNEN SINIR: `AuditEntry.user` bir GÖRÜNEN AD, uid değil; kural onu
    /// `request.auth`a bağlayamaz. Pinlenen şey hesap kimliği (`updatedBy`)
    /// ve an (`updatedAt`). Tek sahipli projede zaten yazabilen tek kişi
    /// sahiptir; damganın işi yetkiyi değil KAYDIN DOĞRULUĞUNU korumak.
    function serverStamped() {
      return request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == uid();
    }

    /// Yöneticinin alt koleksiyona yazma izni + yol tutarlılığı + sunucu damgası.
    ///
    /// KAPSAM alt koleksiyonlarla sınırlı ve bu ÖLÇÜLEREK karar verildi:
    ///   · `users/{uid}` — `UserProfileStore` damgalamadan yazıyor,
    ///   · `invites/{KOD}` ve proje belgesindeki davet aynası —
    ///     `FirebaseInviteService` damgalamadan yazıyor.
    /// Şartı oralara da koymak, davet akışını ve profil kaydını kuralla
    /// kilitlerdi. İkisi ayrı iş olarak açık bırakıldı.
    function ownerWrite(pid) {
      return isOwner(pid) && pathBound(pid) && serverStamped();
    }

    // ─────────────────────────── Kullanıcı profili ───────────────────────────
    //
    // Yalnızca kişinin KENDİSİ. Başka kullanıcıların profilini okumaya gerek yok:
    // ortak listesinde görünen ad `projects/{pid}/partners/{id}.name` alanında,
    // yani projenin içinde duruyor. Profilleri herkese açmak, uid bilen birinin
    // telefon numarasına ulaşması demek olurdu.
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      // Belgedeki `uid` alanı yolla tutarlı olmalı; aksi halde kayıt başka bir
      // kimliğe aitmiş gibi okunabilirdi.
      allow create, update: if signedIn() && uid() == userId
                            && request.resource.data.uid == userId;
      // Hesap silme akışı (Faz 4 / madde 28) Cloud Function ile yapılacak:
      // profil silinirken projelerdeki üyeliğin de temizlenmesi gerekiyor ve
      // istemci başkasının projesindeki `memberUids`e dokunamaz.
      allow delete: if false;
    }

    // ─────────────────────────── Davet kodları ───────────────────────────
    //
    // `invites/{KOD}` — belge kimliği KODUN KENDİSİ, böylece işlev tek `get` ile
    // buluyor (projenin içine gömülü olsaydı "kodu şu olan projeyi bul" bir
    // SORGU olurdu; hem indeks hem daha pahalı).
    //
    // OKUMA HERKESE KAPALI — sahibe de. 6 hane, 31 karakterlik alfabe: okunabilir
    // olsaydı kodlar kaba kuvvetle denenip başkasının projesine girilebilirdi.
    // Yöneticinin kodu görmesi için `projects/{pid}.invite` aynası var; orada
    // kodun kendisi zaten sahibin yazdığı veri.
    //
    // YAZMA: yalnızca projenin sahibi ve yalnızca CREATE. `update` kapalı çünkü
    // kodu harcamak (usedAt) işleve ait bir yetki; sahip bunu kendi eliyle
    // yapabilseydi "kullanıldı" damgası güvenilmez olurdu.
    //
    // Kod çakışması: `create` yalnızca belge YOKKEN geçerli. Aynı kod ikinci kez
    // üretilirse yazma reddedilir ve istemci yeni kod dener — sessizce üzerine
    // yazıp başkasının davetini çalmak mümkün değil.
    // ─────────────────────── Oran sınırı sayacı (madde 71) ───────────────
    //
    // `rateLimits/{uid}` YALNIZCA Cloud Function tarafından yazılıyor (Admin
    // SDK kuralları atlıyor). İstemciye tamamen kapalı ve iki yönü de önemli:
    //   · YAZMA açık olsaydı, sınıra çarpan kullanıcı sayacı sıfırlayıp
    //     korumayı anlamsız kılardı.
    //   · OKUMA açık olsaydı, saldırgan kaç deneme hakkı kaldığını görüp
    //     sınırın hemen altında kalmayı öğrenirdi.
    // Varsayılan red zaten kapatıyor; kural AÇIKÇA yazılı çünkü sessiz bir
    // varsayılana dayanan koruma, bir gün varsayılan değişince sessizce
    // kaybolur.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // ÖMÜR SUNUCU SAATİYLE SINIRLI (31 Ağu 2026).
    //
    // Önceden `createdAt` ve `expiresAt` istemciden geliyordu ve hiçbir şey
    // onları denetlemiyordu: `redeemInvite` süreyi belgedeki `expiresAt`e
    // bakarak ölçüyor (functions/src/index.ts), yani CİHAZ SAATİ ne derse o.
    // Saati ileri alınmış bir cihaz — ya da değiştirilmiş bir istemci — 48
    // saatlik kodu YILLARCA geçerli yapabilirdi. "Kod 48 saat geçerli"
    // cümlesi ekranda yazıyordu ama uygulayan kimse yoktu; bu kod tabanının
    // yedi kez tekrarlanan hatası ("iddia yazılı, uygulayan yok").
    //
    // ÜST SINIR VAR, ALT SINIR YOK ve bu bilinçli: saati GERİ alınmış cihaz
    // kendi kodunu kısa ömürlü yapar — sinir bozucu ama tehlikeli değil ve
    // `redeemInvite` zaten "kodun süresi dolmuş" diyor. Alt sınır konsaydı,
    // saati bozuk kullanıcı davet üretemez hâle gelir ve hata mesajı ona
    // sebebini söyleyemezdi.
    //
    // Slack 1 saat: `createdAt` sunucu damgası, `expiresAt` istemcinin
    // hesabı (48 saat sonrası). İkisi arasındaki ağ gecikmesi ve saat sapması
    // yüzünden tam eşitlik istenemez.
    match /invites/{code} {
      // SAHİP KENDİ PROJESİNİN DAVETİNİ OKUR (23 Eki). Eskiden okuma herkese
      // kapalıydı ve sahip kodu proje belgesindeki AYNADAN görüyordu; ama
      // proje belgesi tüm üyelere açık olduğu için ham kod ortakların
      // cihazına iniyor ve Yedek.json'a sızıyordu. Artık ayna kalkıyor,
      // sahip otoriteyi okuyor.
      //
      // NUMARALAMA KÂHİNİ AÇILMIYOR: `resource != null` kısa devresi, var
      // olmayan kod ile başkasının kodunu AYNI rete düşürüyor (kısa devre
      // olmadan emülatör mesajları "Null value error" / "false" diye
      // ayrışıyordu). `list` kararı verilerden değil sorgu kısıtından
      // veriliyor: `projectId == X` ancak X arayanın projesiyse geçer.
      allow get: if signedIn() && resource != null && isOwner(resource.data.projectId);
      allow list: if signedIn() && isOwner(resource.data.projectId);
      allow create: if signedIn()
                    && request.resource.data.projectId is string
                    && isOwner(request.resource.data.projectId)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt <= request.time + duration.value(49, 'h');
      allow update, delete: if false;
    }

    // ─────────────────────────── Proje belgesi ───────────────────────────

    match /projects/{pid} {

      // Üye olmayan projeyi GÖREMEZ. `list` için istemci sorgusu
      // `whereField("memberUids", arrayContains: uid)` olmak zorunda.
      allow read: if signedIn() && uid() in resource.data.memberUids;

      // Kuran kişi kendini sahip VE ilk üye olarak yazmalı. `ownerUid`'i
      // başkasına ayarlayıp proje "hediye etmek" ya da kendini üye listesine
      // koymadan proje kurup sonra okuyamamak mümkün olmasın.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == uid()
                    && uid() in request.resource.data.memberUids
                    && establishTokenShape()
                    && inviteMirrorShape();

      // Sahiplik DEVREDİLEMEZ ve kimse kendini sahip yapamaz.
      //
      // `memberUids` yalnızca sahip tarafından değiştirilebilir. Sonucu:
      // DAVET AKIŞI İSTEMCİDEN ÇALIŞMAZ — davet edilen kişi ne üye ne sahip
      // olduğu için projeyi okuyup kodu doğrulayamaz, `memberUids`e kendini de
      // ekleyemez. Bu bilinçli: aksi halde herkes herhangi bir projeye
      // kendini ekleyebilirdi. Katılma bir Cloud Function (`redeemInvite`) ile
      // yapılacak; işlev kodu doğrular ve üyeliği yönetici adına yazar.
      allow update: if isOwner(pid)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && uid() in request.resource.data.memberUids
                    && establishTokenUnchanged()
                    && (inviteMirrorShape() || inviteMirrorUnchanged());

      // ── KURULUM YALNIZCA BELGE YOKSA ───────────────────────────────────
      //
      // Kurulum yazması (`.createProject`) rastgele bir dize işaret taşıyor.
      // Var olmayan belgeye yazma `create`: işaret yalnızca BİÇİM olarak
      // denetleniyor. Var olan belgeye yazma `update`: işaretin EKLENMESİ ya
      // da DEĞİŞMESİ reddediliyor. Sonuç: kurulum sunucuda "yalnızca yoksa
      // yaz" — yedekten geri yükleme, istemci ne bilirse bilsin, canlı bir
      // projenin üzerine yazamıyor.
      //
      // Create'te işaret ZORUNLU DEĞİL: derleme 169 ve Android işaret
      // göndermiyor; zorunlu olsa kurulumları kırılırdı.
      //
      // `in` BİÇİMİ ŞART. 169 işareti tanımıyor ve merge'siz TAM yazması onu
      // DÜŞÜRÜYOR; "istekte yoksa geç" koşulu bu yüzden var. `get(k, null) ==
      // get(k, null)` biçimi düşen alanı null sayıp 169'un her düzenlemesini
      // reddederdi (bekçi testleri: "169 işaretli projede").
      //
      // BİLİNEN SINIR: 169'un kendi geri yüklemesi işaret taşımadığı için
      // sıradan bir düzenlemeden ayırt edilemiyor (testte belgelendi).
      // ── DAVET AYNASI YA TAM YA HİÇ (23 Eki) ───────────────────────────
      //
      // Derleme 169 ve Android aynayı ZORUNLU `code` + `createdAt` ile çözüyor
      // ve proje çözümü yalıtılmış değil: `code`'suz bir `invite` haritası o
      // projenin TÜM ÜYELERİNDE panoyu boşaltır. Ayna kaldırılırken hiçbir
      // yazma yolu yarım harita bırakamamalı. Tam ayna 169'un davet partisi
      // için hâlâ geçerli; güncel istemci aynayı yalnızca SİLİYOR.
      function inviteMirrorShape() {
        return !('invite' in request.resource.data)
            || (request.resource.data.invite is map
                && request.resource.data.invite.code is string
                && request.resource.data.invite.createdAt is timestamp);
      }
      // Güncellemede ayna DEĞİŞMİYORSA bekçi devreye girmez: üretimde eski
      // bir yarım ayna kalmışsa sahibin her düzenlemesi (ilerleme, arşiv)
      // reddedilip proje kilitlenirdi. Bekçinin işi yeni yarım harita
      // yazılmasını engellemek, eski veriye takılmak değil.
      function inviteMirrorUnchanged() {
        return request.resource.data.get('invite', null) == resource.data.get('invite', null);
      }
      function establishTokenShape() {
        return !('establishToken' in request.resource.data)
            || (request.resource.data.establishToken is string
                && request.resource.data.establishToken.size() <= 64);
      }
      function establishTokenUnchanged() {
        return !('establishToken' in request.resource.data)
            || ('establishToken' in resource.data
                && request.resource.data.establishToken == resource.data.establishToken);
      }

      // Proje silme henüz hiçbir ekranda yok; açıldığında alt koleksiyonların da
      // temizlenmesi gerekir (istemci bunu atomik yapamaz) → Cloud Function.
      allow delete: if false;

      // ─────────────── Yöneticinin yazdığı, üyenin okuduğu veri ───────────────
      //
      // Malzeme, hareket kaydı, daire, ortak, şantiye fotoğrafı, gider,
      // tahsilat, daire fotoğrafı: aynı kalıp. Ortak SALT OKUR.
      //
      // NOT — gizlilik kapsamı: üye olan biri bedelleri ve tahsilatları
      // görebiliyor. ALICI ADLARINI GÖREMİYOR — onlar aşağıdaki
      // `buyers/{apartmentId}` belgesine taşındı ve orası yalnızca
      // yöneticiye açık. (Bu not eskiden alıcı adlarını da sayıyordu;
      // 19 Eki'de düzeltildi, ayrım yapıldıktan sonra güncellenmemişti.
      // Güvenlik kuralının yanındaki yanlış yorum, sonradan bakan birine
      // yanlış şeyi düzelttirir.)
      //
      // Finansal veri için ANALIZ.md (madde 18 / satır 355) hâlâ geçerli:
      // `partnerVisible` benzeri bir ayrım öneriyor, o ayrım MODELDE yok
      // ve kural veri modelinin taşımadığı bir ayrımı uygulayamaz.
      match /materials/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      match /materialLogs/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      match /apartments/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      // ─────────────── Alıcı kimliği: YALNIZCA yöneticiye ───────────────
      //
      // `buyers/{apartmentId}` → { apartmentId, projectId, name }
      //
      // NEDEN AYRI BELGE: güvenlik kuralı ALAN GİZLEYEMEZ. Bir belgeyi okumaya
      // izin verir ya da vermez. `buyerName` daire belgesinde kaldığı sürece
      // ortağın cihazına İNER; ekranda gizlemek yalnızca görüntüyü değiştirir,
      // sızıntıyı kapatmaz. (Belgelerdeki `partnerVisible` ile aynı ders.)
      //
      // NEDEN GİZLİ: ortak bir yatırımcı ve payını hesaplamak için daire
      // durumunu, bedeli, tahsilatı görmesi gerekiyor — bunlar `apartments`
      // belgesinde açık. Ama ALICININ KİMLİĞİ hiçbir yatırım amacına hizmet
      // etmiyor ve o kişi müteahhidin ortaklarına görünmeye rıza vermedi.
      // KVKK veri minimizasyonu tam olarak bunu söylüyor. Şeffaflık iddiası
      // zayıflamıyor: iddia para akışı üzerine, alıcı listesi üzerine değil.
      //
      // Belge kimliği = daire kimliği: yönetici tek sorguyla projenin tüm
      // alıcılarını çekip dairelerle eşleştiriyor.
      match /buyers/{apartmentId} {
        allow read: if isOwner(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      match /partners/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      match /sitePhotos/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      match /expenses/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      match /payments/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      // ORTAK CARİ HESABI (madde 82) — sermaye, çekim, kâr dağıtımı.
      //
      // GİZLİLİK KARARI BURADA ALINIYOR, EKRANDA DEĞİL: A ortağı B'nin
      // çektiği parayı GÖRÜR. Karar `buyers/{apartmentId}` ile aynı sınıfta
      // ama sonucu TERS ve sebebi şu: alıcı ÜÇÜNCÜ KİŞİ, ortaklara
      // görünmeyi hiç kabul etmedi; ortak ise hesabın TARAFI. Aynı kasaya
      // kimin ne koyduğu ve kimin ne çektiği, hepsinin aynı havuz üzerindeki
      // iddiasını belirliyor — bunu gizlemek, uygulamanın önlemek için var
      // olduğu "kim ne aldı" tartışmasını WhatsApp'a geri gönderir ve
      // yöneticinin her ortağa ayrı hikâye anlatmasına izin verirdi.
      //
      // Ortak YAZAMAZ: `ownerWrite(pid)`. Kendi çektiğini kendi yazabilseydi
      // kayıt bir mutabakat belgesi olmaktan çıkardı.
      match /partnerLedger/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      // TAKSİT PLANI (madde 21) — beklenen ödemeler ve vadeleri.
      //
      // ORTAK OKUR. Yeni bir gizlilik yüzeyi DEĞİL: ortak bugün zaten daire
      // detayında gerçekleşmiş ödemelerin tarihini ve tutarını görüyor, yani
      // "şu daireye aylardır para gelmiyor" bilgisi elinde. Vadeleri gizlemek
      // ortağı bilgisiz bırakmaz, yalnızca aynı sonucu elle çıkarmaya zorlar —
      // üstelik şeffaflık iddiasıyla çelişir. ALICI KİMLİĞİ burada da yok:
      // kayıt yalnızca daire kimliği, sıra, vade ve tutar taşıyor.
      match /installments/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      match /apartmentPhotos/{docId} {
        allow read: if isMember(pid);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      // ─────────────── Belgeler: ortak görünürlüğü ───────────────
      //
      // Tek `read` kuralı `get` ve `list`i birlikte kapsıyor:
      //  · sahip → hepsini okur (sorgu kısıtı gerekmez),
      //  · üye   → yalnızca `partnerVisible == true`; sorgu bunu GARANTİ
      //            etmiyorsa Firestore sorgunun tamamını reddeder.
      // "Gizle ama indir" deseni böylece imkânsız: gizli belge ortağın yerel
      // önbelleğine hiç inmez.
      match /documents/{docId} {
        allow read: if isMember(pid)
                    && (isOwner(pid) || resource.data.partnerVisible == true);
        allow create, update: if ownerWrite(pid);
        allow delete: if isOwner(pid);
      }

      // ─────────────── Hareket akışı ve denetim defteri: EKLE-ONLY ───────────────
      //
      // İkisi de uygulamanın şeffaflık iddiasının dayanağı. Geçmişin sonradan
      // düzeltilebilmesi o iddiayı boşa çıkarırdı: yönetici yanlış bir satışı
      // iptal ettiğinde izin denetim defterinde kalması gerekiyor, silinebilmesi
      // değil. `update`/`delete` istemciden KAPALI — bu, istemcinin kendi
      // başına sağlayamayacağı bir garanti.
      match /activities/{docId} {
        allow read: if isMember(pid);
        allow create: if ownerWrite(pid);
        allow update, delete: if false;
      }

      match /auditEntries/{docId} {
        allow read: if isMember(pid);
        allow create: if ownerWrite(pid);
        allow update, delete: if false;
      }
    }

    // ─────────────────────────── Varsayılan: RED ───────────────────────────
    //
    // Yukarıda açıkça izin verilmeyen her yol kapalı. Yeni bir koleksiyon
    // eklendiğinde sessizce dünyaya açılmaması için bu satır bilinçli olarak
    // en sonda ve açıkça yazılı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
